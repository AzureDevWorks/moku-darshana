/*
 * Moku Darśana
 * Reader Overlay
 *
 * Fixed reading surface.
 * No visible scrollbars.
 * Text remains responsive and contained inside
 * the available viewport.
 */

.reader-overlay {
  position: fixed;
  inset: 0;
  z-index: 1000;

  width: 100vw;
  height: 100vh;

  overflow: hidden;

  display: flex;
  align-items: center;
  justify-content: center;

  box-sizing: border-box;
}

.reader-overlay *,
.reader-overlay *::before,
.reader-overlay *::after {
  box-sizing: border-box;
}

.reader-backdrop {
  position: absolute;
  inset: 0;

  background: rgba(0, 0, 0, 0.78);

  backdrop-filter: blur(5px);
  -webkit-backdrop-filter: blur(5px);
}

.reader-shell {
  position: relative;
  z-index: 1;

  width: min(1100px, 94vw);
  height: min(900px, 92vh);

  min-height: 0;

  display: grid;
  grid-template-rows:
    auto
    auto
    minmax(0, 1fr)
    auto;

  overflow: hidden;

  border: 1px solid rgba(210, 170, 100, 0.25);
  border-radius: 18px;

  background:
    radial-gradient(
      circle at 50% 0%,
      rgba(170, 120, 50, 0.08),
      transparent 45%
    ),
    #100c09;

  box-shadow:
    0 30px 80px rgba(0, 0, 0, 0.65),
    0 0 0 1px rgba(255, 255, 255, 0.02);

  color: #eee3d0;
}

.reader-header {
  min-height: 0;

  display: flex;
  align-items: center;
  justify-content: space-between;

  gap: 20px;

  padding: 18px 24px;

  border-bottom: 1px solid rgba(255, 255, 255, 0.08);
}

.reader-header-left {
  min-width: 0;
}

.reader-collection {
  margin-bottom: 5px;

  font-size: 0.68rem;
  letter-spacing: 0.18em;
  text-transform: uppercase;

  color: #b89967;
}

.reader-title {
  margin: 0;

  font-family: Georgia, "Times New Roman", serif;
  font-size: clamp(1.25rem, 2vw, 1.8rem);
  font-weight: 500;

  line-height: 1.2;

  color: #f1dfbf;

  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.reader-header-actions {
  display: flex;
  align-items: center;
  gap: 8px;

  flex-shrink: 0;
}

.reader-icon-button {
  width: 38px;
  height: 38px;

  display: inline-flex;
  align-items: center;
  justify-content: center;

  padding: 0;

  border: 1px solid rgba(255, 255, 255, 0.12);
  border-radius: 50%;

  background: rgba(255, 255, 255, 0.04);
  color: #e9d7b8;

  font-size: 1.15rem;

  cursor: pointer;

  transition:
    background 0.2s ease,
    border-color 0.2s ease,
    transform 0.2s ease;
}

.reader-icon-button:hover {
  background: rgba(255, 255, 255, 0.08);
  border-color: rgba(210, 170, 100, 0.35);
}

.reader-icon-button:active {
  transform: scale(0.95);
}

/* -------------------------------------------------------
 * TOOLBAR
 * ----------------------------------------------------- */

.reader-toolbar {
  min-height: 54px;

  display: grid;
  grid-template-columns: 1fr auto 1fr;
  align-items: center;

  gap: 12px;

  padding: 8px 18px;

  border-bottom: 1px solid rgba(255, 255, 255, 0.06);

  background: rgba(0, 0, 0, 0.16);
}

.reader-language-switch {
  display: flex;
  gap: 4px;
  justify-self: start;
}

.reader-language {
  padding: 6px 10px;

  border: 1px solid transparent;
  border-radius: 7px;

  background: transparent;
  color: #9d9489;

  font-size: 0.76rem;

  cursor: pointer;
}

.reader-language.active {
  border-color: rgba(210, 170, 100, 0.25);

  background: rgba(210, 170, 100, 0.08);

  color: #e4c894;
}

.reader-toolbar-center {
  min-width: 0;

  text-align: center;

  font-size: 0.76rem;
  color: #9d8f7d;

  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.reader-toolbar-right {
  display: flex;
  justify-content: flex-end;
  align-items: center;
  gap: 8px;
}

.reader-secondary-button,
.reader-listen-button {
  min-height: 32px;

  padding: 6px 12px;

  border-radius: 7px;

  font-size: 0.76rem;

  cursor: pointer;
}

.reader-secondary-button {
  border: 1px solid rgba(255, 255, 255, 0.10);

  background: rgba(255, 255, 255, 0.035);

  color: #c9bba6;
}

.reader-listen-button {
  border: 1px solid rgba(210, 170, 100, 0.28);

  background: rgba(210, 170, 100, 0.10);

  color: #e8c98e;
}

.reader-listen-button.playing {
  background: rgba(210, 170, 100, 0.20);
}

.reader-listen-button:disabled {
  opacity: 0.35;
  cursor: not-allowed;
}

/* -------------------------------------------------------
 * AUDIO ERROR
 * ----------------------------------------------------- */

.reader-audio-error {
  flex-shrink: 0;

  padding: 7px 16px;

  text-align: center;

  font-size: 0.72rem;

  color: #d7a6a0;

  background: rgba(130, 40, 40, 0.12);

  border-bottom: 1px solid rgba(160, 80, 70, 0.15);
}

/* -------------------------------------------------------
 * MAIN READING AREA
 * ----------------------------------------------------- */

.reader-main {
  min-height: 0;

  overflow: hidden;

  display: flex;
  align-items: center;
  justify-content: center;

  padding: clamp(18px, 4vh, 42px) clamp(18px, 5vw, 70px);
}

.reader-page {
  width: 100%;
  height: 100%;

  min-width: 0;
  min-height: 0;

  display: flex;
  align-items: center;
  justify-content: center;
}

.reader-card {
  position: relative;

  width: min(850px, 100%);
  height: min(100%, 600px);

  min-height: 0;

  perspective: 1400px;
}

.reader-card-face {
  position: absolute;
  inset: 0;

  width: 100%;
  height: 100%;

  min-height: 0;

  overflow: hidden;

  border: 1px solid rgba(210, 170, 100, 0.18);
  border-radius: 14px;

  background:
    linear-gradient(
      145deg,
      rgba(255, 255, 255, 0.035),
      rgba(255, 255, 255, 0.012)
    ),
    #15100c;

  box-shadow:
    inset 0 1px 0 rgba(255, 255, 255, 0.025),
    0 18px 50px rgba(0, 0, 0, 0.22);

  backface-visibility: hidden;
  -webkit-backface-visibility: hidden;

  transition:
    transform 0.55s ease;
}

.reader-card-front {
  transform: rotateY(0deg);

  display: flex;
  align-items: center;
  justify-content: center;
}

.reader-card-back {
  transform: rotateY(180deg);

  display: flex;
  align-items: center;
  justify-content: center;
}

.reader-card.flipped .reader-card-front {
  transform: rotateY(-180deg);
}

.reader-card.flipped .reader-card-back {
  transform: rotateY(0deg);
}

/* -------------------------------------------------------
 * TEXT CONTENT
 * ----------------------------------------------------- */

.reader-card-content {
  --reader-fit-scale: 1;

  width: 100%;
  height: 100%;
  min-width: 0;
  min-height: 0;

  max-width: 100%;
  max-height: 100%;

  overflow: hidden;

  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;

  box-sizing: border-box;

  padding: clamp(1rem, 3vw, 3rem);

  /*
   * The JavaScript fitting logic changes this variable.
   * Short verses stay at 1.
   * Long verses visually scale down only as much as needed.
   */
  transform: scale(var(--reader-fit-scale));
  transform-origin: center center;

  transition: transform 120ms ease-out;
}

.reader-verse-number {
  margin-bottom: clamp(14px, 2vh, 24px);

  font-size: 0.7rem;
  letter-spacing: 0.18em;
  text-transform: uppercase;

  color: #b89967;
}

.reader-sanskrit {
  width: 100%;
  max-width: 720px;

  font-family:
    "Noto Serif Devanagari",
    "Nirmala UI",
    "Mangal",
    serif;

  font-size: clamp(1.45rem, 3vw, 2.35rem);
  line-height: 1.75;

  font-weight: 500;

  color: #f2dfbd;

  overflow-wrap: anywhere;
  word-break: normal;
}

.reader-iast {
  width: 100%;
  max-width: 680px;

  margin-top: clamp(14px, 2vh, 24px);

  font-family:
    Georgia,
    "Times New Roman",
    serif;

  font-size: clamp(0.86rem, 1.4vw, 1.05rem);
  line-height: 1.7;

  font-style: italic;

  color: #b8aa96;

  overflow-wrap: anywhere;
}

.reader-meaning {
  width: 100%;
  max-width: 650px;

  margin-top: clamp(16px, 2.5vh, 28px);

  font-family:
    Georgia,
    "Times New Roman",
    serif;

  font-size: clamp(0.9rem, 1.45vw, 1.08rem);
  line-height: 1.75;

  color: #d2c5b1;

  overflow-wrap: anywhere;
}

.reader-section-label {
  margin-bottom: 20px;

  font-size: 0.72rem;
  letter-spacing: 0.16em;
  text-transform: uppercase;

  color: #b89967;
}

.reader-prose {
  text-align: left;
  align-items: stretch;
}

.reader-prose-title {
  margin-bottom: 16px;

  font-family:
    "Noto Serif Devanagari",
    "Nirmala UI",
    "Mangal",
    serif;

  font-size: clamp(1rem, 1.8vw, 1.3rem);

  color: #d8bd8d;
}

.reader-prose-text {
  width: 100%;

  font-family:
    Georgia,
    "Times New Roman",
    serif;

  font-size: clamp(0.9rem, 1.35vw, 1.05rem);
  line-height: 1.8;

  color: #cfc1ac;

  white-space: pre-line;

  overflow-wrap: anywhere;
}

.reader-back-label {
  margin-bottom: 20px;

  font-size: 0.7rem;
  letter-spacing: 0.16em;
  text-transform: uppercase;

  color: #b89967;
}

.reader-commentary {
  width: 100%;
  max-width: 680px;

  font-family:
    Georgia,
    "Times New Roman",
    serif;

  font-size: clamp(0.9rem, 1.4vw, 1.08rem);
  line-height: 1.8;

  color: #d0c2ad;

  overflow-wrap: anywhere;
}

.reader-empty {
  color: #81786d;

  font-family:
    Georgia,
    "Times New Roman",
    serif;

  font-size: 0.95rem;
}

/* -------------------------------------------------------
 * FOOTER
 * ----------------------------------------------------- */

.reader-footer {
  min-height: 68px;

  display: grid;
  grid-template-columns: 1fr auto 1fr;
  align-items: center;

  gap: 16px;

  padding: 10px 20px;

  border-top: 1px solid rgba(255, 255, 255, 0.07);

  background: rgba(0, 0, 0, 0.18);
}

.reader-nav-button {
  justify-self: start;

  min-height: 36px;

  padding: 7px 13px;

  border: 1px solid rgba(255, 255, 255, 0.10);
  border-radius: 7px;

  background: rgba(255, 255, 255, 0.035);

  color: #c5b9a7;

  font-size: 0.76rem;

  cursor: pointer;
}

.reader-nav-button:last-child {
  justify-self: end;
}

.reader-nav-button:disabled {
  opacity: 0.28;
  cursor: not-allowed;
}

.reader-progress {
  text-align: center;
}

.reader-progress-main {
  font-size: 0.76rem;
  color: #bda987;
}

.reader-progress-sub {
  margin-top: 3px;

  font-size: 0.65rem;

  color: #70685e;
}

/* -------------------------------------------------------
 * CONTENTS
 * ----------------------------------------------------- */

.reader-contents {
  position: absolute;
  z-index: 10;

  top: 0;
  right: 0;
  bottom: 0;

  width: min(390px, 88vw);

  display: flex;
  flex-direction: column;

  overflow: hidden;

  background: #120d0a;

  border-left: 1px solid rgba(210, 170, 100, 0.16);

  box-shadow:
    -20px 0 50px rgba(0, 0, 0, 0.35);
}

.reader-contents-header {
  flex-shrink: 0;

  display: flex;
  align-items: center;
  justify-content: space-between;

  gap: 14px;

  padding: 18px;

  border-bottom: 1px solid rgba(255, 255, 255, 0.07);
}

.reader-contents-kicker {
  margin-bottom: 4px;

  font-size: 0.65rem;
  letter-spacing: 0.16em;

  color: #a88d61;
}

.reader-contents-header h2 {
  margin: 0;

  font-family: Georgia, "Times New Roman", serif;

  font-size: 1.1rem;
  font-weight: 500;

  color: #e4d3b6;
}

.reader-contents-list {
  min-height: 0;

  overflow-y: auto;

  scrollbar-width: none;
}

.reader-contents-list::-webkit-scrollbar {
  display: none;
}

.reader-content-item {
  width: 100%;

  display: grid;
  grid-template-columns: 32px minmax(0, 1fr);

  gap: 10px;

  padding: 12px 16px;

  border: 0;
  border-bottom: 1px solid rgba(255, 255, 255, 0.045);

  background: transparent;

  text-align: left;

  color: #bdb1a0;

  cursor: pointer;
}

.reader-content-item:hover {
  background: rgba(255, 255, 255, 0.035);
}

.reader-content-item.active {
  background: rgba(210, 170, 100, 0.08);
  color: #e1c58f;
}

.reader-content-number {
  color: #796e60;
  font-size: 0.72rem;
}

.reader-content-text {
  min-width: 0;

  display: flex;
  flex-direction: column;

  gap: 3px;
}

.reader-content-title {
  overflow-wrap: anywhere;
}

.reader-content-meta {
  font-size: 0.65rem;
  color: #756b60;
}

/* -------------------------------------------------------
 * AUDIO ELEMENT
 * ----------------------------------------------------- */

.reader-audio {
  display: none;
}

/* -------------------------------------------------------
 * FOCUS
 * ----------------------------------------------------- */

.reader-overlay button:focus-visible {
  outline: 2px solid rgba(210, 170, 100, 0.65);
  outline-offset: 2px;
}

/* -------------------------------------------------------
 * TABLET
 * ----------------------------------------------------- */

@media (max-width: 800px) {
  .reader-shell {
    width: 96vw;
    height: 94vh;

    border-radius: 14px;
  }

  .reader-toolbar {
    grid-template-columns: auto minmax(0, 1fr) auto;
  }

  .reader-main {
    padding: 14px;
  }

  .reader-card {
    height: 100%;
  }

  .reader-card-content {
  --reader-fit-scale: 1;

  width: 100%;
  height: 100%;
  min-width: 0;
  min-height: 0;

  max-width: 100%;
  max-height: 100%;

  overflow: hidden;

  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;

  box-sizing: border-box;

  padding: clamp(1rem, 3vw, 3rem);

  /*
   * The JavaScript fitting logic changes this variable.
   * Short verses stay at 1.
   * Long verses visually scale down only as much as needed.
   */
  transform: scale(var(--reader-fit-scale));
  transform-origin: center center;

  transition: transform 120ms ease-out;
}

/* -------------------------------------------------------
 * PHONE
 * ----------------------------------------------------- */

@media (max-width: 560px) {
  .reader-shell {
    width: 100vw;
    height: 100vh;

    border: 0;
    border-radius: 0;
  }

  .reader-header {
    padding: 13px 14px;
  }

  .reader-title {
    font-size: 1.15rem;
  }

  .reader-toolbar {
    min-height: 48px;

    padding: 6px 10px;

    gap: 6px;
  }

  .reader-language {
    padding: 5px 7px;

    font-size: 0.68rem;
  }

  .reader-toolbar-center {
    font-size: 0.65rem;
  }

  .reader-secondary-button,
  .reader-listen-button {
    padding: 5px 8px;

    font-size: 0.67rem;
  }

  .reader-main {
    padding: 10px;
  }

  .reader-card-content {
  --reader-fit-scale: 1;

  width: 100%;
  height: 100%;
  min-width: 0;
  min-height: 0;

  max-width: 100%;
  max-height: 100%;

  overflow: hidden;

  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;

  box-sizing: border-box;

  padding: clamp(1rem, 3vw, 3rem);

  /*
   * The JavaScript fitting logic changes this variable.
   * Short verses stay at 1.
   * Long verses visually scale down only as much as needed.
   */
  transform: scale(var(--reader-fit-scale));
  transform-origin: center center;

  transition: transform 120ms ease-out;
}

/* -------------------------------------------------------
 * REDUCED MOTION
 * ----------------------------------------------------- */

@media (prefers-reduced-motion: reduce) {
  .reader-card-face {
    transition: none;
  }

  .reader-icon-button {
    transition: none;
  }
}

/* ============================================================
   MOKU DARŚANA — DYNAMIC TEXT FIT OVERRIDES
   ============================================================ */

.reader-card-content .reader-sanskrit,
.reader-card-content .sanskrit {
  max-width: 100%;
  overflow-wrap: anywhere;
  word-break: normal;
  text-wrap: balance;
}

.reader-card-content .reader-iast,
.reader-card-content .iast {
  max-width: 100%;
  overflow-wrap: anywhere;
  word-break: normal;
  text-wrap: pretty;
}

.reader-card-content .reader-meaning,
.reader-card-content .meaning,
.reader-card-content .reader-prose,
.reader-card-content .prose,
.reader-card-content .reader-commentary,
.reader-card-content .commentary {
  max-width: 100%;
  overflow-wrap: anywhere;
  word-break: normal;
  text-wrap: pretty;
}

/*
 * Prevent long URLs / unbroken strings from forcing the
 * reading surface wider than the card.
 */
.reader-card-content * {
  max-width: 100%;
  box-sizing: border-box;
}

/*
 * The reader itself never gets a visible scrollbar.
 */
.reader-overlay,
.reader-shell,
.reader-main,
.reader-card,
.reader-card-face,
.reader-card-content {
  scrollbar-width: none;
}

.reader-overlay::-webkit-scrollbar,
.reader-shell::-webkit-scrollbar,
.reader-main::-webkit-scrollbar,
.reader-card::-webkit-scrollbar,
.reader-card-face::-webkit-scrollbar,
.reader-card-content::-webkit-scrollbar {
  display: none;
}

/*
 * Keep the audio control from becoming part of the text
 * measurement problem.
 */
.reader-card-content audio {
  display: none;
}

/*
 * Very long Sanskrit lines should wrap instead of pushing
 * outside the card.
 */
.reader-card-content [class*="sanskrit"] {
  overflow-wrap: anywhere;
  white-space: normal;
}

/*
 * Respect users who prefer reduced motion.
 */
@media (prefers-reduced-motion: reduce) {
  .reader-card-content {
    transition: none;
  }
}
